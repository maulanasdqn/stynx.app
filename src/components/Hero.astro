---
import TerminalWindow from "./TerminalWindow.astro";
const repo = "https://github.com/maulanasdqn/stynx-code";

const ascii = String.raw` ____   _____ __   __ _   _ __  __
/ ___| |_   _|\ \ / /| \ | |\ \/ /
\___ \   | |   \ V / |  \| | \  /
 ___) |  | |    | |  | |\  | /  \
|____/   |_|    |_|  |_| \_|/_/\_\
            c o d e`;
---

<section class="hero" id="top">
  <div class="container hero-grid">
    <div class="hero-copy reveal">
      <span class="tag hero-badge">
        <span class="ping"></span> v0.33.17 · written in Rust · MIT
      </span>

      <h1 class="hero-title">
        The AI coding agent that <span class="grad">lives in your terminal</span>.
      </h1>

      <p class="hero-sub">
        <strong>stynx-code</strong> is a self-contained terminal app for getting
        work done with an LLM. Native Claude API, any OpenAI-compatible endpoint,
        and an autonomous tool-using loop behind a permission system that prompts
        only when you ask it to.
      </p>

      <div class="hero-cta">
        <a class="btn btn-primary" href="#install">Get started →</a>
        <a class="btn btn-foam" href="/docs/">Read the docs →</a>
        <a class="btn btn-ghost" href={repo} target="_blank" rel="noopener">
          GitHub
        </a>
      </div>

      <a class="install-pill" href="#install">
        <span class="prompt">$</span> cargo install stynx-code
        <span class="pill-note">on crates.io</span>
      </a>
    </div>

    <div class="hero-demo reveal">
      <pre class="ascii" aria-hidden="true">{ascii}</pre>

      <div class="rotator" data-rotator>
        <div class="tabs" role="tablist" aria-label="stynx-code modes & features">
          <button class="tab is-active" data-i="0" role="tab">one-shot</button>
          <button class="tab" data-i="1" role="tab">plan mode</button>
          <button class="tab" data-i="2" role="tab">intern</button>
          <button class="tab" data-i="3" role="tab">thinking</button>
          <button class="tab" data-i="4" role="tab">fast</button>
        </div>

        <div class="rot-progress" aria-hidden="true"><span class="bar-fill"></span></div>

        <div class="slides">
          <div class="slide is-active" data-i="0">
            <TerminalWindow title="stynx — one-shot">
              <div><span class="prompt">$</span> <span class="cmd">stynx -p</span> <span class="rose">"find every TODO under src/"</span></div>
              <div class="muted">· thinking…</div>
              <div><span class="pine">⏺ grep</span> <span class="muted">pattern="TODO" path="src/" -n</span></div>
              <div class="ok">  ↳ 7 matches across 3 files</div>
              <div class="answer">
                <span class="accent">src/engine/loop.rs</span>  — 3 TODOs<br />
                <span class="accent">src/tui/render.rs</span>   — 2 TODOs<br />
                <span class="accent">src/tools/bash.rs</span>   — 2 TODOs
              </div>
            </TerminalWindow>
          </div>

          <div class="slide" data-i="1">
            <TerminalWindow title="stynx — plan mode">
              <div><span class="prompt">&gt;</span> <span class="cmd">/plan</span> <span class="rose">add a --version flag</span></div>
              <div class="muted">◆ plan mode · read-only tools</div>
              <div><span class="pine">⏺ read</span> <span class="muted">src/cli.rs</span></div>
              <div><span class="pine">⏺ grep</span> <span class="muted">"Command::" -n</span></div>
              <div class="answer">
                <span class="accent">Plan</span><br />
                1. add <span class="foam">Version</span> variant to Command<br />
                2. parse it in cli.rs<br />
                3. print <span class="foam">env!("CARGO_PKG_VERSION")</span>
              </div>
              <div class="ok">  ↳ approve to apply</div>
            </TerminalWindow>
          </div>

          <div class="slide" data-i="2">
            <TerminalWindow title="stynx — intern delegation">
              <div><span class="prompt">&gt;</span> <span class="rose">swap println! → tracing in src/io.rs</span></div>
              <div><span class="iris">⚇ delegate_to_deepseek</span></div>
              <div class="muted">  task: rewrite 14 println! calls</div>
              <div class="muted">  intern · deepseek-chat</div>
              <div class="ok">  ↳ Summary: 14 edits · 1 file</div>
              <div><span class="ok">✓ senior reviewed &amp; integrated</span></div>
            </TerminalWindow>
          </div>

          <div class="slide" data-i="3">
            <TerminalWindow title="stynx — extended thinking">
              <div><span class="prompt">&gt;</span> <span class="cmd">/think</span> <span class="rose">why is this test flaky?</span></div>
              <div class="muted">◆ thinking · high effort</div>
              <div class="think-line">The test shares a TempDir across cases;<br />case order mutates the fixture state…</div>
              <div><span class="pine">⏺ read</span> <span class="muted">tests/fs.rs</span></div>
              <div class="ok">  ↳ root cause: shared TempDir</div>
            </TerminalWindow>
          </div>

          <div class="slide" data-i="4">
            <TerminalWindow title="stynx — fast mode">
              <div><span class="prompt">&gt;</span> <span class="cmd">/fast</span></div>
              <div><span class="accent">⚡ Fast mode on →</span> <span class="foam">claude-haiku-4-5</span></div>
              <div><span class="prompt">&gt;</span> <span class="rose">rename `cfg` to `config` repo-wide</span></div>
              <div><span class="pine">⏺ grep</span> <span class="muted">"cfg" -n</span></div>
              <div><span class="pine">⏺ file_edit</span> <span class="muted">×6</span></div>
              <div><span class="ok">✓ done in 2 turns · cheap &amp; instant</span></div>
            </TerminalWindow>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 4.5rem 5.5rem;
  }
  .hero-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  .hero-badge {
    color: var(--text);
  }
  .ping {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--foam);
    box-shadow: 0 0 0 0 rgba(156, 207, 216, 0.6);
    animation: ping 2s var(--ease) infinite;
  }
  @keyframes ping {
    0% {
      box-shadow: 0 0 0 0 rgba(156, 207, 216, 0.5);
    }
    70% {
      box-shadow: 0 0 0 8px rgba(156, 207, 216, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(156, 207, 216, 0);
    }
  }
  .hero-title {
    margin-top: 1.2rem;
    font-size: clamp(2.2rem, 6vw, 3.6rem);
  }
  .grad {
    background: linear-gradient(120deg, var(--iris), var(--foam), var(--rose));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-sub {
    margin-top: 1.3rem;
    max-width: 36rem;
    color: var(--subtle);
    font-size: 1.1rem;
  }
  .hero-sub strong {
    color: var(--text);
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }
  .install-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.4rem;
    padding: 0.6rem 0.95rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--hl-med);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 0.88rem;
    color: var(--text);
    transition: border-color 0.18s var(--ease), transform 0.18s var(--ease);
  }
  .install-pill:hover {
    border-color: var(--gold);
    transform: translateY(-2px);
  }
  .install-pill .prompt {
    color: var(--iris);
  }
  .install-pill .pill-note {
    margin-left: 0.3rem;
    color: var(--muted);
    font-size: 0.78rem;
  }
  .hero-demo {
    position: relative;
  }
  .ascii {
    font-family: var(--font-mono);
    font-size: clamp(0.5rem, 1.5vw, 0.72rem);
    line-height: 1.2;
    color: var(--iris);
    margin-bottom: 1rem;
    overflow-x: auto;
    opacity: 0.9;
  }
  .answer {
    margin-top: 0.6rem;
    color: var(--text);
  }
  .think-line {
    color: var(--subtle);
    font-style: italic;
    padding: 0.2rem 0 0.4rem 0.8rem;
    border-left: 2px solid var(--hl-high);
    margin: 0.2rem 0;
  }
  .foam {
    color: var(--foam);
  }

  /* Rotator */
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.7rem;
  }
  .tab {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--hl-med);
    border-radius: 999px;
    padding: 0.26rem 0.7rem;
    cursor: pointer;
    transition: color 0.18s var(--ease), border-color 0.18s var(--ease), background 0.18s var(--ease);
  }
  .tab:hover {
    color: var(--text);
  }
  .tab.is-active {
    color: var(--base);
    background: linear-gradient(135deg, var(--iris), var(--foam));
    border-color: transparent;
    font-weight: 600;
  }
  .rot-progress {
    height: 2px;
    background: var(--hl-med);
    border-radius: 2px;
    overflow: hidden;
    margin-bottom: 0.85rem;
  }
  .bar-fill {
    display: block;
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, var(--iris), var(--foam));
  }
  @keyframes fill {
    from {
      width: 0;
    }
    to {
      width: 100%;
    }
  }
  .rotator.paused .bar-fill {
    animation-play-state: paused;
  }
  .slides {
    display: grid;
  }
  .slide {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.45s var(--ease), transform 0.45s var(--ease);
    pointer-events: none;
  }
  .slide.is-active {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .slide {
      transition: none;
    }
    .rot-progress {
      display: none;
    }
  }

  @media (min-width: 768px) {
    .hero-grid {
      grid-template-columns: 1.05fr 1fr;
    }
  }
</style>

<script is:inline>
  (function () {
    const root = document.querySelector("[data-rotator]");
    if (!root) return;
    const tabs = [...root.querySelectorAll(".tab")];
    const slides = [...root.querySelectorAll(".slide")];
    if (!tabs.length || !slides.length) return;

    const bar = root.querySelector(".bar-fill");
    const DURATION = 5000;
    let i = 0;
    let timer;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function animateBar() {
      if (!bar || reduce) return;
      bar.style.animation = "none";
      void bar.offsetWidth;
      bar.style.animation = "fill " + DURATION + "ms linear";
    }
    function show(n) {
      i = (n + slides.length) % slides.length;
      tabs.forEach((t, k) => t.classList.toggle("is-active", k === i));
      slides.forEach((s, k) => s.classList.toggle("is-active", k === i));
      animateBar();
    }
    function startTimer() {
      if (reduce) return;
      clearInterval(timer);
      timer = setInterval(() => show(i + 1), DURATION);
    }
    function stopTimer() {
      clearInterval(timer);
    }

    tabs.forEach((t, k) =>
      t.addEventListener("click", () => {
        show(k);
        startTimer();
      })
    );
    root.addEventListener("mouseenter", () => {
      stopTimer();
      root.classList.add("paused");
    });
    root.addEventListener("mouseleave", () => {
      root.classList.remove("paused");
      show(i);
      startTimer();
    });

    show(0);
    startTimer();
  })();
</script>
