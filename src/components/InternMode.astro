---
import TerminalWindow from "./TerminalWindow.astro";

const interns = [
  { name: "deepseek", color: "var(--foam)" },
  { name: "qwen-coder", color: "var(--iris)" },
  { name: "kimi", color: "var(--gold)" },
  { name: "gemini-flash", color: "var(--rose)" },
  { name: "mimo", color: "var(--pine)" },
];

const features = [
  {
    icon: "⚇",
    color: "var(--foam)",
    title: "Mix any providers",
    body: "Run any number of interns at once — DeepSeek, OpenRouter, Qwen, OpenAI, or a local Ollama — side by side, each on its own model.",
  },
  {
    icon: "⛓",
    color: "var(--iris)",
    title: "First-class tools",
    body: "Every intern is exposed as its own delegate_to_<name> tool, so the senior delegates with a normal tool call — no special syntax.",
  },
  {
    icon: "⇄",
    color: "var(--gold)",
    title: "Routes by description",
    body: "The senior picks the right intern from each tool's description — write what each is good at (speed, cost, specialty) and it chooses.",
  },
  {
    icon: "→",
    color: "var(--rose)",
    title: "Call one directly",
    body: "/intern <name> <task> hands work to a specific intern; /intern <task> uses the first one. You stay in control when you want it.",
  },
  {
    icon: "⛨",
    color: "var(--pine)",
    title: "Sandboxed & safe",
    body: "Interns get a restricted toolset — bash, read, file_write, file_edit, glob, grep — and can't spawn further sub-agents.",
  },
  {
    icon: "🏁",
    color: "var(--love)",
    title: "Benchmark & rank",
    body: "/intern-bench runs a fixed suite and grades each intern (LLM-as-judge) into a leaderboard, saved to .stynx/intern-bench.md.",
  },
];
---

<section class="section intern" id="intern">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">// the killer feature</span>
      <h2 class="section-title">Intern mode: one senior, a team of cheap interns.</h2>
      <p class="section-sub">
        This is what sets stynx-code apart. Pick any lead model, then let it
        delegate the grunt work to one or more cheaper models running in
        parallel. The senior does the thinking; the interns do the typing — and
        you spend a fraction of the tokens. Swap the lead any time with
        <code>/model</code>; every other model becomes a
        <code>delegate_to_&lt;name&gt;</code> tool.
      </p>
    </div>

    <div class="intern-grid">
      <div class="reveal">
        <div class="fanout" aria-hidden="true">
          <div class="senior">
            <span class="role">senior · your pick</span>
            <span class="who">claude-sonnet-4-6</span>
            <span class="swap">⇄ swap with /model</span>
          </div>
          <div class="links">
            {interns.map(() => <span class="link"></span>)}
          </div>
          <div class="interns">
            {
              interns.map((i) => (
                <span class="chip" style={`--c:${i.color}`}>
                  delegate_to_{i.name.replace("-", "_")}
                </span>
              ))
            }
          </div>
        </div>

        <p class="note">
          Interns run a restricted toolset — <code>bash</code>, <code>read</code>,
          <code>file_write</code>, <code>file_edit</code>, <code>glob</code>,
          <code>grep</code> — and can't spawn further sub-agents. They return
          <em>Summary / Files changed / Output</em>; the senior reviews and
          integrates.
        </p>
      </div>

      <div class="reveal">
        <TerminalWindow title="stynx — /intern-bench">
          <div><span class="prompt">&gt;</span> <span class="cmd">/intern-bench</span></div>
          <div class="muted">🏁 Intern Benchmark — 3 intern(s) × 6 tasks</div>
          <div>&nbsp;</div>
          <div class="muted">Leaderboard (avg score, then speed):</div>
          <div><span class="accent">🥇 #1</span>  deepseek    <span class="ok">8.5/10</span>  pass 6/6   <span class="muted">42.3s</span></div>
          <div><span class="rose">🥈 #2</span>  qwen-coder  <span class="ok">7.2/10</span>  pass 5/6   <span class="muted">55.1s</span></div>
          <div><span class="love">🥉 #3</span>  mimo        <span class="accent">5.0/10</span>  pass 4/6   <span class="muted">88.0s</span></div>
          <div>&nbsp;</div>
          <div class="muted">↳ full report → .stynx/intern-bench.md</div>
        </TerminalWindow>
        <p class="note">
          Not sure which intern is pulling its weight? The built-in benchmark
          runs a fixed task suite against each, then has the main model
          <strong>grade every answer</strong> (LLM-as-judge) for a ranked
          leaderboard.
        </p>
      </div>
    </div>

    <div class="intern-features">
      {
        features.map((f) => (
          <article class="ifeat reveal" style={`--c:${f.color}`}>
            <span class="ifeat-ic">{f.icon}</span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .intern {
    background: linear-gradient(180deg, transparent, var(--hl-low), transparent);
  }
  .intern-grid {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }
  .fanout {
    background: var(--surface);
    border: 1px solid var(--hl-med);
    border-radius: var(--radius);
    padding: 1.6rem;
    text-align: center;
  }
  .senior {
    display: inline-flex;
    flex-direction: column;
    padding: 0.7rem 1.4rem;
    border-radius: var(--radius-sm);
    background: linear-gradient(135deg, var(--iris), var(--rose));
    color: var(--base);
    font-family: var(--font-mono);
  }
  .senior .role {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    opacity: 0.8;
  }
  .senior .who {
    font-weight: 700;
  }
  .senior .swap {
    font-size: 0.66rem;
    opacity: 0.75;
    margin-top: 0.15rem;
  }
  .links {
    display: flex;
    justify-content: center;
    gap: 2.5rem;
    height: 28px;
    margin: 0.2rem 0;
  }
  .link {
    width: 1px;
    background: linear-gradient(var(--hl-high), transparent);
  }
  .interns {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.55rem;
  }
  .chip {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    color: var(--c);
    background: color-mix(in srgb, var(--c) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--c) 32%, transparent);
  }
  .note {
    margin-top: 1.2rem;
    color: var(--subtle);
    font-size: 0.95rem;
  }
  .note code {
    color: var(--foam);
    font-size: 0.85em;
  }

  .intern-features {
    margin-top: 2.6rem;
    display: grid;
    gap: 1.1rem;
    grid-template-columns: 1fr;
  }
  .ifeat {
    border: 1px solid var(--hl-med);
    border-top: 2px solid var(--c);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 1.4rem;
    transition: transform 0.22s var(--ease), border-color 0.22s var(--ease);
  }
  .ifeat:hover {
    transform: translateY(-4px);
  }
  .ifeat-ic {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    font-size: 1.15rem;
    color: var(--c);
    background: color-mix(in srgb, var(--c) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--c) 30%, transparent);
    margin-bottom: 0.85rem;
  }
  .ifeat h3 {
    font-size: 1.05rem;
    margin-bottom: 0.4rem;
  }
  .ifeat p {
    color: var(--subtle);
    font-size: 0.9rem;
  }

  @media (min-width: 880px) {
    .intern-grid {
      grid-template-columns: 1fr 1fr;
    }
    .intern-features {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 560px) and (max-width: 879px) {
    .intern-features {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
