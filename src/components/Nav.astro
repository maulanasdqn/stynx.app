---
const repo = "https://github.com/maulanasdqn/stynx-code";
---

<header class="nav">
  <div class="container nav-inner">
    <a href="#top" class="brand" aria-label="stynx-code home">
      <span class="brand-mark">▚</span>
      <span class="brand-name">stynx<span class="brand-accent">-code</span></span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      <a href="#showcase">Demo</a>
      <a href="#ai">AI&nbsp;Engine</a>
      <a href="#features">Features</a>
      <a href="#intern">Intern&nbsp;Mode</a>
      <a href="#power">Power</a>
      <a href="/docs/">Docs</a>
      <a href="#install">Install</a>
    </nav>

    <a class="btn btn-ghost nav-cta" href={repo} target="_blank" rel="noopener">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/>
      </svg>
      GitHub
    </a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(12px);
    background: color-mix(in srgb, var(--base) 78%, transparent);
    border-bottom: 1px solid var(--hl-low);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.05rem;
  }
  .brand-mark {
    color: var(--iris);
    font-size: 1.2rem;
  }
  .brand-accent {
    color: var(--muted);
  }
  .nav-links {
    display: none;
    gap: 1.6rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }
  .nav-links a {
    color: var(--subtle);
    transition: color 0.18s var(--ease);
  }
  .nav-links a:hover {
    color: var(--foam);
  }
  .nav-cta {
    padding: 0.5rem 0.95rem;
    font-size: 0.85rem;
  }
  @media (min-width: 768px) {
    .nav-links {
      display: flex;
    }
  }
</style>
