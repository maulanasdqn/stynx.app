---
interface Props {
  title?: string;
}
const { title } = Astro.props;
---

<div class="code">
  {title && <div class="code-bar">{title}</div>}
  <pre><code><slot /></code></pre>
</div>

<style>
  .code {
    border-radius: var(--radius-sm);
    border: 1px solid var(--hl-med);
    background: var(--base);
    overflow: hidden;
    margin: 1rem 0 1.4rem;
  }
  .code-bar {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    padding: 0.5rem 0.95rem;
    background: var(--overlay);
    border-bottom: 1px solid var(--hl-low);
  }
  pre {
    margin: 0;
    padding: 1rem 1.1rem;
    overflow-x: auto;
  }
  code {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    line-height: 1.65;
    color: var(--text);
    white-space: pre;
  }
</style>
