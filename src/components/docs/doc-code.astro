---
import { Code } from "astro:components";

interface Props {
  title?: string;
  lang?: string;
  code: string;
}
const { title, lang = "bash", code } = Astro.props;

const src = code.replace(/^\n/, "").replace(/\n$/, "");
---

<div class="code">
  {title && <div class="code-bar">{title}</div>}
  <Code code={src} lang={lang} theme="rose-pine" />
</div>

<style>
  .code {
    border-radius: var(--radius-sm);
    border: 1px solid var(--hl-med);
    overflow: hidden;
    margin: 1rem 0 1.4rem;
  }
  .code-bar {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    padding: 0.5rem 0.95rem;
    background: var(--overlay);
    border-bottom: 1px solid var(--hl-low);
  }
  .code :global(pre) {
    margin: 0;
    padding: 1rem 1.1rem;
    overflow-x: auto;
    font-size: 0.84rem;
    line-height: 1.65;
  }
  .code :global(code) {
    font-family: var(--font-mono);
    white-space: pre;
  }
</style>
