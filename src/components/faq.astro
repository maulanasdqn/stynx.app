---
const repo = "https://github.com/maulanasdqn/stynx-code";

const faqs = [
  {
    q: "What does Stynx actually do?",
    a: "It's an AI coding agent you run on your own machine. Describe a task and it reads your code, plans, edits files, runs commands and tests, and reports back. Use it as a fast terminal app (stynx) or as a desktop app with a full editor, terminal, and git built in.",
  },
  {
    q: "How is it cheaper than other agents?",
    a: "Intern mode. A strong model like Claude stays in charge as the senior and spends its tokens on planning and review, while cheaper models (DeepSeek, Qwen, OpenRouter, local Ollama, and more) do the mechanical work. Automatic context compaction and a live cost readout keep spend in check.",
  },
  {
    q: "How much does it cost?",
    a: "Stynx is free and MIT licensed. You only pay your model providers for the tokens you use, and the status line plus /cost show your spend live, so there are no surprises.",
  },
  {
    q: "Which models can I use?",
    a: "Anthropic's Claude natively, plus any OpenAI-compatible endpoint: DeepSeek, OpenAI, OpenRouter, Qwen/DashScope, Together, and local Ollama. Mix providers freely and swap the lead model any time with /model.",
  },
  {
    q: "Do I need an API key or a subscription?",
    a: "You bring your own. Claude works with your Claude login (OAuth) or an ANTHROPIC_API_KEY, and interns use their provider's API key. Nothing is bundled and nothing is resold: your keys, your account.",
  },
  {
    q: "Does it send my code anywhere?",
    a: "Only to the model providers you configure, which is how every LLM agent works. There's no telemetry and no analytics, and your credentials stay on your machine. It's fully open source, so you can verify exactly what it does.",
  },
  {
    q: "Which platforms are supported?",
    a: "The desktop app runs on macOS (Apple Silicon and Intel), Windows 10/11, and Linux (AppImage, .deb, .rpm). The CLI installs with cargo install stynx-code on macOS and Linux.",
  },
  {
    q: "Is it production-ready?",
    a: "It's pre-1.0 and moving fast. It's used daily for real work, but expect the occasional rough edge or breaking change. Work on a git branch and review its diffs before committing, as you would with any agent.",
  },
  {
    q: "How do I report a bug or contribute?",
    a: "Open an issue or pull request on GitHub. Bug reports and feedback are genuinely useful right now.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<section class="section faq" id="faq">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">// faq</span>
      <h2 class="section-title">Questions, answered.</h2>
    </div>

    <div class="status-note reveal">
      <span class="badge">early days</span>
      <p>
        Heads up: stynx-code is <strong>pre-1.0 and still under heavy
        development</strong>. It's stable enough for daily use, but expect the
        occasional rough edge and breaking change. Work on a git branch and
        review its edits before committing.
      </p>
    </div>

    <div class="faq-list">
      {
        faqs.map((f, i) => (
          <details class="faq-item reveal" open={i === 0}>
            <summary>
              <span>{f.q}</span>
              <span class="chev" aria-hidden="true">+</span>
            </summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>

    <p class="more reveal">
      Still stuck? Everything's documented in the <a href="/docs/">docs</a> or
      ask on <a href={repo} target="_blank" rel="noopener">GitHub</a>.
    </p>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</section>

<style>
  .status-note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    padding: 1rem 1.2rem;
    margin-bottom: 1.6rem;
    border: 1px solid color-mix(in srgb, var(--gold) 35%, var(--hl-med));
    border-left: 3px solid var(--gold);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--gold) 7%, var(--surface));
  }
  .status-note .badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--base);
    background: var(--gold);
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
    font-weight: 700;
    flex-shrink: 0;
  }
  .status-note p {
    color: var(--subtle);
    font-size: 0.93rem;
    margin: 0;
    flex: 1;
    min-width: 16rem;
  }
  .status-note strong {
    color: var(--gold);
  }

  .faq-list {
    display: grid;
    gap: 0.7rem;
    max-width: 52rem;
  }
  .faq-item {
    border: 1px solid var(--hl-med);
    border-radius: var(--radius-sm);
    background: var(--surface);
    overflow: hidden;
  }
  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.2rem;
    cursor: pointer;
    font-weight: 600;
    color: var(--text);
    list-style: none;
    transition: color 0.18s var(--ease);
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary:hover {
    color: var(--foam);
  }
  .chev {
    font-family: var(--font-mono);
    font-size: 1.3rem;
    color: var(--iris);
    transition: transform 0.22s var(--ease);
    flex-shrink: 0;
  }
  .faq-item[open] .chev {
    transform: rotate(45deg);
  }
  .faq-item p {
    padding: 0 1.2rem 1.15rem;
    color: var(--subtle);
    font-size: 0.94rem;
    margin: 0;
  }
  .more {
    margin-top: 1.6rem;
    color: var(--subtle);
    font-size: 0.94rem;
  }
  .more a {
    color: var(--foam);
    border-bottom: 1px solid color-mix(in srgb, var(--foam) 40%, transparent);
  }
</style>
