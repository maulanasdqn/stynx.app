---
---

<div class="visual reveal" aria-hidden="true">
  <img class="app" src="/desktop-code.webp" width="2880" height="1800" alt="" fetchpriority="high" decoding="async" />

  <div class="float stats">
    <div class="stats-head">
      <span>Token split</span>
      <span class="meta">example</span>
    </div>
    <div class="bars">
      <div class="col">
        <span class="col-label">Senior</span>
        <div class="bar"><span class="fill senior" style="height: 22%"><b>22%</b></span></div>
      </div>
      <div class="col">
        <span class="col-label">Interns</span>
        <div class="bar"><span class="fill interns" style="height: 78%"><b>78%</b></span></div>
      </div>
    </div>
  </div>

  <div class="float bubble">
    <span class="bubble-icon">✓</span>
    <span>netra finished the task.<br />Reviewed and scored 9/10</span>
  </div>

  <div class="caption">
    <span class="caption-icon">⌘</span>
    <span>Senior plans. Interns type.</span>
    <span class="dots"><i class="on"></i><i></i></span>
  </div>
</div>

<style>
  .visual {
    position: relative;
    min-height: 560px;
    border-radius: 28px;
    overflow: hidden;
    background:
      radial-gradient(60% 45% at 78% 18%, rgba(255, 255, 255, 0.55), transparent 70%),
      radial-gradient(70% 50% at 10% 95%, rgba(255, 255, 255, 0.35), transparent 70%),
      linear-gradient(180deg, var(--sky-top), var(--sky-bottom));
  }
  .app {
    position: absolute;
    left: 9%;
    top: 30%;
    width: 128%;
    height: auto;
    max-width: none;
    border-radius: 14px;
    box-shadow: 0 40px 80px -30px rgba(10, 30, 60, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.25);
  }
  .float {
    position: absolute;
    background: #ffffff;
    color: var(--ink);
    box-shadow: 0 24px 50px -24px rgba(10, 30, 60, 0.45);
  }
  .stats {
    top: 7%;
    right: 7%;
    width: 15.5rem;
    padding: 0.9rem;
    border-radius: 16px;
    font-size: 0.8rem;
  }
  .stats-head {
    display: flex;
    justify-content: space-between;
    gap: 0.6rem;
    font-weight: 500;
  }
  .meta {
    color: var(--muted);
    font-size: 0.72rem;
  }
  .bars {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
    margin-top: 0.7rem;
  }
  .col-label {
    display: block;
    padding: 0.35rem 0.5rem;
    border-radius: 6px;
    background: var(--surface);
    font-size: 0.72rem;
  }
  .bar {
    position: relative;
    height: 7.5rem;
    margin-top: 0.4rem;
  }
  .fill {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    border-radius: 6px;
    padding: 0.35rem 0.45rem;
    font-size: 0.75rem;
  }
  .fill b {
    font-weight: 500;
  }
  .senior {
    background: #a9c8ff;
  }
  .interns {
    background: #93e2c6;
  }
  .bubble {
    left: 5%;
    bottom: 20%;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.4rem 0.85rem 0.9rem;
    border-radius: 999px;
    font-size: 0.92rem;
    line-height: 1.3;
  }
  .bubble-icon {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #4f8cff;
    color: #ffffff;
    font-weight: 700;
  }
  .caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.1rem 1.4rem;
    color: #ffffff;
    font-size: 1rem;
    font-weight: 500;
    background: linear-gradient(180deg, transparent, rgba(8, 22, 44, 0.55));
  }
  .caption-icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #ffffff;
    color: var(--ink);
    font-size: 0.85rem;
  }
  .dots {
    margin-left: auto;
    display: flex;
    gap: 6px;
  }
  .dots i {
    width: 34px;
    height: 3px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.4);
  }
  .dots i.on {
    background: #ffffff;
  }
  @media (max-width: 560px) {
    .visual { min-height: 440px; }
    .stats { width: 12.5rem; right: 5%; }
    .bar { height: 5.5rem; }
    .app { top: 42%; }
  }
</style>
