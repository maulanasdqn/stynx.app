---
import HeroVisual from "./hero-visual.astro";
import { loadDesktopRelease } from "../lib/desktop-release";

const release = await loadDesktopRelease();
const version = release?.version ?? null;
const pick = (id: string, label: string) => release?.platforms.find((p) => p.id === id)?.downloads.find((d) => d.label === label) ?? null;
const targets = {
  macArm: pick("mac", "Apple Silicon"),
  macIntel: pick("mac", "Intel"),
  windows: pick("windows", "Installer"),
  linux: pick("linux", "AppImage"),
};
---

<section class="hero" id="top">
  <div class="container hero-grid">
    <div class="copy">
      <a class="tag badge reveal" href="#download">
        <span class="badge-icon">★</span>
        Free and open source{version && <span class="ver">· v{version}</span>}
      </a>

      <h1 class="title reveal">Senior-level AI coding at intern prices</h1>

      <div class="bottom">
        <p class="sub reveal">
          Claude leads as your senior engineer and hands the busywork to cheaper
          models. Stynx plans, delegates, reviews every result, and ships the
          change, in your terminal or a full desktop IDE.
        </p>

        <div class="cta reveal">
          <a class="btn btn-primary btn-lg" href="#download" id="hero-download" data-targets={JSON.stringify(targets)}>Download free</a>
          <a class="btn btn-ghost btn-lg" href="#install">Install the CLI</a>
        </div>
        <p class="dl-meta reveal" id="hero-download-meta"><a href="#download">All platforms and formats</a></p>
      </div>
    </div>

    <HeroVisual />
  </div>
</section>

<style>
  .hero {
    padding-block: 1.5rem 3.5rem;
  }
  .hero-grid {
    display: grid;
    gap: 2.5rem;
  }
  .copy {
    display: flex;
    flex-direction: column;
    padding-top: 2.5rem;
  }
  .badge {
    align-self: flex-start;
  }
  .badge-icon {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 6px;
    border: 1px solid var(--hl-med);
    font-size: 0.8rem;
  }
  .ver {
    color: var(--muted);
  }
  .title {
    margin-top: 2.2rem;
    font-size: clamp(2.9rem, 5.6vw, 4.7rem);
    line-height: 0.98;
    letter-spacing: -0.05em;
    font-weight: 600;
  }
  .bottom {
    margin-top: 2.5rem;
  }
  .sub {
    max-width: 30rem;
    font-size: 1.12rem;
    line-height: 1.6;
    color: var(--subtle);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2rem;
  }
  .btn-lg {
    padding: 1rem 1.7rem;
    font-size: 1rem;
  }
  .dl-meta {
    margin-top: 0.9rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .dl-meta a {
    color: var(--subtle);
    text-decoration: underline;
    text-decoration-color: var(--hl-high);
    text-underline-offset: 3px;
  }
  @media (min-width: 980px) {
    .hero-grid {
      grid-template-columns: 1fr 1.05fr;
      gap: 3.5rem;
      align-items: stretch;
    }
    .copy {
      padding-block: 3rem 1rem;
    }
    .bottom {
      margin-top: auto;
      padding-top: 2.5rem;
    }
  }
</style>

<script src="../scripts/hero-download.js"></script>
