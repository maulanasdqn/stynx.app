---
const repo = "https://github.com/maulanasdqn/stynx-code";
const apiUrl = "https://api.github.com/repos/maulanasdqn/stynx-code";

const fmt = (n: number) =>
  n >= 1000 ? (n / 1000).toFixed(1).replace(/\.0$/, "") + "k" : String(n);

const token = process.env.GITHUB_TOKEN;
let stars: number | null = null;
try {
  const r = await fetch(apiUrl, { headers: token ? { "User-Agent": "stynx-app", Authorization: `Bearer ${token}` } : { "User-Agent": "stynx-app" } });
  if (r.ok) {
    const j = await r.json();
    if (typeof j.stargazers_count === "number") stars = j.stargazers_count;
  }
} catch {}
const starLabel = stars === null ? "" : fmt(stars);
---

<header class="nav">
  <div class="container nav-inner">
    <a href="/#top" class="brand" aria-label="Stynx home">
      <img class="brand-mark" src="/favicon.svg" width="30" height="30" alt="" />
      <span class="brand-name">Stynx</span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      <a href="/#intern">How it works</a>
      <a href="/#desktop">Desktop</a>
      <a href="/#features">Features</a>
      <a href="/#faq">FAQ</a>
      <a href="/docs/">Docs</a>
    </nav>

    <div class="nav-actions">
      <a class="pill pill-light" href={repo} target="_blank" rel="noopener" aria-label={`Stynx on GitHub${starLabel ? `, ${starLabel} stars` : ""}`}>
        <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/>
        </svg>
        <span class="gh-label">GitHub</span>
        <span class="stars" id="star-count" data-repo={apiUrl}>{starLabel && `★ ${starLabel}`}</span>
      </a>
      <a class="pill pill-dark" href="/#download">Download</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: saturate(180%) blur(14px);
    background: color-mix(in srgb, var(--base) 82%, transparent);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 76px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }
  .brand-mark {
    display: block;
    border-radius: 9px;
  }
  .nav-links {
    display: none;
    align-items: center;
    gap: 1.8rem;
    font-size: 0.95rem;
  }
  .nav-links a {
    color: var(--subtle);
    transition: color 0.18s var(--ease);
  }
  .nav-links a:hover {
    color: var(--text);
  }
  .nav-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 1.05rem;
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 500;
    white-space: nowrap;
    transition: background 0.18s var(--ease);
  }
  .pill-light {
    background: var(--overlay);
  }
  .pill-light:hover {
    background: var(--hl-med);
  }
  .pill-dark {
    background: var(--ink);
    color: #ffffff;
  }
  .pill-dark:hover {
    background: #26262a;
  }
  .stars {
    color: var(--subtle);
    font-variant-numeric: tabular-nums;
  }
  .gh-label {
    display: none;
  }
  @media (min-width: 560px) {
    .gh-label {
      display: inline;
    }
  }
  @media (min-width: 900px) {
    .nav-links {
      display: flex;
    }
  }
</style>

<script is:inline>
  (async function () {
    const el = document.getElementById("star-count");
    if (!el) return;
    try {
      const res = await fetch(el.dataset.repo);
      if (!res.ok) return;
      const n = (await res.json()).stargazers_count;
      if (typeof n !== "number") return;
      el.textContent = "★ " + (n >= 1000 ? (n / 1000).toFixed(1).replace(/\.0$/, "") + "k" : String(n));
    } catch (e) {}
  })();
</script>
