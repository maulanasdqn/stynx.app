---
const providers = [
  { name: "Claude", style: "font-family: Georgia, 'Times New Roman', serif; font-weight: 500; letter-spacing: -0.01em;" },
  { name: "DeepSeek", style: "font-weight: 700; letter-spacing: -0.04em;" },
  { name: "OpenRouter", style: "font-weight: 500; letter-spacing: -0.02em;" },
  { name: "Qwen", style: "font-weight: 800; letter-spacing: 0.02em;" },
  { name: "OpenAI", style: "font-weight: 600; letter-spacing: -0.03em;" },
  { name: "Ollama", style: "font-family: var(--font-mono); font-weight: 500;" },
];
---

<section class="works" id="providers-strip" aria-label="Works with">
  <div class="container">
    <p class="label">Works with the models you already use</p>
    <ul class="strip">
      {providers.map((p) => <li><span style={p.style}>{p.name}</span></li>)}
    </ul>
  </div>
</section>

<style>
  .works {
    border-top: 1px solid var(--hl-med);
    border-bottom: 1px solid var(--hl-med);
    padding-block: 2.2rem;
  }
  .label {
    text-align: center;
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 1.4rem;
  }
  .strip {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    row-gap: 1.2rem;
  }
  .strip li {
    display: grid;
    place-items: center;
    font-size: 1.25rem;
    color: #3a3a3f;
  }
  @media (min-width: 600px) {
    .strip {
      grid-template-columns: repeat(3, 1fr);
    }
    .strip li {
      font-size: 1.45rem;
    }
  }
  @media (min-width: 860px) {
    .strip {
      grid-template-columns: repeat(6, 1fr);
    }
    .strip li + li {
      border-left: 1px solid var(--hl-med);
    }
  }
</style>
