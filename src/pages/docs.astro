---
import Layout from "../layouts/layout.astro";
import DocsSidebar from "../components/docs/docs-sidebar.astro";
import DocsGettingStarted from "../components/docs/docs-getting-started.astro";
import DocsConfig from "../components/docs/docs-config.astro";
import DocsDelegation from "../components/docs/docs-delegation.astro";
import DocsWorkflow from "../components/docs/docs-workflow.astro";
import DocsReference from "../components/docs/docs-reference.astro";
import DocsShortcuts from "../components/docs/docs-shortcuts.astro";
import "../styles/docs.css";
import "../styles/docs-tables.css";

const repo = "https://github.com/maulanasdqn/stynx-code";
---

<Layout
  title="Documentation: stynx-code"
  description="Technical documentation for stynx-code: installation, configuration, models & AI controls, the permission system, intern delegation, sessions, skills, hooks, the full tool reference, keybindings, and slash commands."
>
  <div class="docs">
    <DocsSidebar />

    <main class="content">
      <header class="doc-hero">
        <span class="eyebrow">// documentation · v0.33.17</span>
        <h1>stynx-code</h1>
        <p class="lede">
          An interactive AI coding assistant for the terminal. Multi-provider,
          tool-using, fast. This page maps every feature and explains how to use
          it. The product is <code>stynx-code</code>; the command you type is
          <code>stynx</code>.
        </p>
      </header>

      <DocsGettingStarted />
      <DocsConfig />
      <DocsDelegation />
      <DocsWorkflow />
      <DocsReference />
      <DocsShortcuts />

      <footer class="doc-foot">
        <p>License: MIT · <a href={repo} target="_blank" rel="noopener">github.com/maulanasdqn/stynx-code</a></p>
        <a class="btn btn-ghost" href="/">← Back to home</a>
      </footer>
    </main>
  </div>

  <script is:inline>
    (function () {
      const links = new Map();
      document.querySelectorAll("[data-toc]").forEach((a) =>
        links.set(a.getAttribute("data-toc"), a)
      );
      const sections = document.querySelectorAll(".content section[id]");
      if (!("IntersectionObserver" in window)) return;
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              links.forEach((a) => a.classList.remove("active"));
              const a = links.get(e.target.id);
              if (a) a.classList.add("active");
            }
          });
        },
        { rootMargin: "-20% 0px -70% 0px" }
      );
      sections.forEach((s) => io.observe(s));
    })();
  </script>
</Layout>
