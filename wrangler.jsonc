{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stynx-app",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "stynx.app", "custom_domain": true },
    { "pattern": "www.stynx.app", "custom_domain": true }
  ]
}
